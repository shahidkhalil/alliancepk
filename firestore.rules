rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Any signed-in Firebase Auth user (create in Console; keep public signup off).
    function isAdmin() {
      return request.auth != null;
    }

    function strMax(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= max);
    }

    function optNumber(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] is number
        || request.resource.data[field] == null;
    }

    function isAuditAnswers(data) {
      return data is map
        && data.keys().hasOnly([
          'businessType', 'monthlyCustomers', 'marketingBudget',
          'biggestChallenge', 'primaryGoal'
        ])
        && data.businessType is string && data.businessType.size() <= 80
        && data.monthlyCustomers is string && data.monthlyCustomers.size() <= 120
        && data.marketingBudget is string && data.marketingBudget.size() <= 80
        && data.biggestChallenge is string && data.biggestChallenge.size() <= 80
        && data.primaryGoal is string && data.primaryGoal.size() <= 600;
    }

    function isGrowthReport(data) {
      return data is map
        && data.keys().hasOnly([
          'growthScore', 'summary', 'biggestIssues', 'opportunities',
          'recommendedServices', 'timeline', 'estimatedROI', 'nextSteps'
        ])
        && data.growthScore is number
        && data.growthScore >= 0
        && data.growthScore <= 100
        && data.summary is string
        && data.summary.size() <= 1200
        && data.biggestIssues is list
        && data.biggestIssues.size() <= 8
        && data.opportunities is list
        && data.opportunities.size() <= 8
        && data.recommendedServices is list
        && data.recommendedServices.size() <= 8
        && data.nextSteps is list
        && data.nextSteps.size() <= 8
        && data.timeline is string
        && data.timeline.size() <= 300
        && data.estimatedROI is string
        && data.estimatedROI.size() <= 500;
    }

    function hasTimestamp(field) {
      return field in request.resource.data
        && request.resource.data[field] is timestamp;
    }

    // Completed form submissions — public create with schema limits; admin-only manage
    match /leads/{doc} {
      allow create: if request.resource.data.keys().hasAll(['source', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'clinicName', 'clinicType', 'message',
          'source', 'website', 'auditScore', 'auditVerdict', 'topIssue',
          'completionStatus', 'status',
          'createdAt', 'updatedAt', 'step',
          'growthReport', 'auditAnswers'
        ])
        && request.resource.data.source is string
        && request.resource.data.source.size() > 0
        && request.resource.data.source.size() <= 64
        && strMax('name', 120)
        && strMax('phone', 40)
        && strMax('email', 160)
        && strMax('clinicName', 160)
        && strMax('clinicType', 80)
        && strMax('message', 2000)
        && strMax('website', 300)
        && strMax('auditVerdict', 200)
        && strMax('topIssue', 200)
        && strMax('completionStatus', 32)
        && strMax('status', 32)
        && optNumber('auditScore')
        && optNumber('step')
        && hasTimestamp('createdAt')
        && (!('growthReport' in request.resource.data)
          || (request.resource.data.source == 'business_growth_audit'
            && isGrowthReport(request.resource.data.growthReport)))
        && (!('auditAnswers' in request.resource.data)
          || (request.resource.data.source == 'business_growth_audit'
            && isAuditAnswers(request.resource.data.auditAnswers)))
        // Require at least one contact channel to cut empty spam.
        && (
          (request.resource.data.keys().hasAny(['email'])
            && request.resource.data.email is string
            && request.resource.data.email.size() > 3)
          || (request.resource.data.keys().hasAny(['phone'])
            && request.resource.data.phone is string
            && request.resource.data.phone.size() >= 7)
        );
      allow read, update, delete: if isAdmin();
    }

    // Abandoned forms — create/update only; no client delete (stops wipe attacks)
    match /form_drafts/{doc} {
      allow create, update: if request.resource.data.keys().hasAll(['source', 'updatedAt'])
        && request.resource.data.keys().hasOnly([
          'name', 'phone', 'email', 'clinicName', 'clinicType', 'message',
          'source', 'completionStatus', 'step', 'createdAt', 'updatedAt',
          'alertSent', 'submittedAt'
        ])
        && request.resource.data.source is string
        && request.resource.data.source.size() <= 64
        && strMax('name', 120)
        && strMax('phone', 40)
        && strMax('email', 160)
        && strMax('clinicName', 160)
        && strMax('clinicType', 80)
        && strMax('message', 2000)
        && strMax('completionStatus', 32)
        && optNumber('step')
        && hasTimestamp('updatedAt');
      allow read: if isAdmin();
      allow delete: if false;
    }

    // Blog likes — read public; writes may only change count by ±1 via increment()
    match /blog_likes/{doc} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && request.resource.data.count <= 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['count', 'updatedAt'])
        && request.resource.data.count is int
        && request.resource.data.count >= 0
        && (
          request.resource.data.count == resource.data.count + 1
          || request.resource.data.count == resource.data.count - 1
        );
      allow delete: if false;
    }

    // Blog posts — public read; admin (signed-in) write only
    match /blogs/{slug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Maya bookings — admin read; status-only updates (new/completed/cancelled)
    match /appointments/{doc} {
      allow read: if isAdmin();
      allow create, delete: if false;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'statusUpdatedAt', 'statusUpdatedBy'])
        && request.resource.data.status is string
        && request.resource.data.status in ['new', 'completed', 'cancelled'];
    }

    // Maya patient memory — admin read only
    match /patients/{doc} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Lock everything else (audits, orders, cache = Admin SDK only).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
